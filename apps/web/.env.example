# ─── evnx-web ─────────────────────────────────────────────────────────────────
#
# Copy to `.env.local` and fill in what you need.
#
# ⚠️ EVERYTHING HERE IS OPTIONAL. The site builds and runs with none of it set.
#    That is deliberate: `next build` used to die on a clean checkout because
#    /testimonials reached for Supabase at build time. A marketing site must
#    not require credentials to render its own content.
#
#    Run `evnx scan` before committing. Run `evnx diff` to compare this file
#    against your `.env.local`.

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Backs four optional widgets: testimonials, waitlist, helpful-vote, and the
# testimonial submission form. Unset → those widgets are disabled, nothing else
# changes. The anon key is public by design; RLS policies are the boundary.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠️⚠️ SERVER-ONLY AND HIGH PRIVILEGE. This key BYPASSES ROW LEVEL SECURITY.
#
# It must never gain a NEXT_PUBLIC_ prefix — that would inline it into the
# browser bundle and hand every visitor full read/write on the database.
# Read only by app/api/waitlist/route.ts, which falls back to the anon key
# when it is absent, so leaving it blank locally is correct and safe.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Testimonials ─────────────────────────────────────────────────────────────
# ⚠️ Gates PROMOTION only, not the page. "true" adds the header link, the
# footer link and the sitemap entry. /testimonials and its submission form
# stay reachable either way — which is the trap: with this unset there is NO
# link to the form anywhere on the site, so the only people who can leave a
# testimonial are the ones who already know the URL.
#
# Turn it on once there are at least three approved rows. Two looks like a
# favour, one looks like a mistake. See packages/config/src/features.ts.
NEXT_PUBLIC_TESTIMONIALS_ENABLED=

# ─── GitHub ───────────────────────────────────────────────────────────────────
# Raises the GitHub API rate limit for the star counter in the footer and
# /api/github-stars. Unset → unauthenticated requests, 60/hour, which is fine
# locally and marginal in CI. A read-only token with no scopes is enough.
GITHUB_TOKEN=

# ─── Site ─────────────────────────────────────────────────────────────────────
# Canonical origin. Set per-deploy so previews self-canonicalise instead of
# claiming to be production. Default: https://evnx.dev
NEXT_PUBLIC_SITE_URL=

# ─── The docs split ───────────────────────────────────────────────────────────
# `inline` → docs served from evnx.dev/guides/*   (today)
# `split`  → docs served from docs.evnx.dev/cli/* (after schedule P3)
#
# ⚠️ Flipping this repoints every documentation link in the app. Flip it only
# once docs.evnx.dev answers for every URL in docs/migration/url-inventory.csv.
# Set it to `split` on a preview deploy first.
NEXT_PUBLIC_DOCS_MODE=inline

# ─── The install script ───────────────────────────────────────────────────────
# `dotenv.space` → the URL that answers today
# `evnx.dev`     → after schedule P5 serves /install.sh
#
# ⚠️ Pointing this at evnx.dev before P5 puts a 404 in the hero's copy button.
NEXT_PUBLIC_INSTALL_HOST=dotenv.space

# ─── Analytics ────────────────────────────────────────────────────────────────
# Self-hosted Umami, proxied through /stats to survive ad blockers.
# Unset → analytics are disabled, which is what you want locally.
#
# ⚠️ Marketing analytics run on evnx.dev ONLY. Never on app.evnx.dev, where
# master keys live in a Web Worker. See SPEC §13 and ADR-1.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# ─── Build-time only ──────────────────────────────────────────────────────────
# Where `scripts/sync-config.mjs` reads plan limits from.
# Default: https://api.evnx.dev — override to point at a local server.
EVNX_API_URL=
