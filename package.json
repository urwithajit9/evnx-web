{
  "name": "evnx-web-monorepo",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "config:sync": "node scripts/sync-config.mjs",
    "config:check": "node scripts/sync-config.mjs --check",
    "check:links": "node scripts/check-content-links.mjs",
    "baseline:analytics": "node scripts/export-analytics.mjs",
    "baseline:crawl": "node scripts/crawl-inventory.mjs",
    "verify:redirects": "node scripts/verify-redirects.mjs",
    "cli:index": "node scripts/sync-command-index.mjs",
    "cli:index:check": "node scripts/sync-command-index.mjs --check",
    "cli:check": "node scripts/check-cli-invocations.mjs",
    "cli:diff": "node scripts/diff-cli-surface.mjs",
    "guide:commands": "node scripts/sync-guide-commands.mjs",
    "guide:commands:check": "node scripts/sync-guide-commands.mjs --check"
  },
  "devDependencies": {
    "turbo": "^2.3.3"
  }
}
